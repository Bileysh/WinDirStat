<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinDirStat_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sizers="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:WinDirStat_App.Converters"
    xmlns:uc="using:WinDirStat_App.UserControls"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:FileCategoryToBrushConverter x:Key="CategoryToBrushConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <MenuBar Grid.Row="0">
            <MenuBarItem Title="File">
                <MenuFlyoutItem Text="Open Folder..." Icon="Folder" Command="{x:Bind ViewModel.OpenFolderCommand}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Exit" Icon="Cancel" />
            </MenuBarItem>
            <MenuBarItem Title="Window">
                <MenuFlyoutItem Text="Open in New Window" Icon="NewWindow" Command="{x:Bind ViewModel.OpenInNewWindowCommand}" />
            </MenuBarItem>
            <MenuBarItem Title="Options">
                <MenuFlyoutItem Text="Show Free Space" />
            </MenuBarItem>
            <MenuBarItem Title="Help">
                <MenuFlyoutItem Text="About WinDirStat" Icon="Help" />
            </MenuBarItem>
        </MenuBar>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="6*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="4*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="4*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="8" CornerRadius="4" BorderThickness="1"
                        BorderBrush="{ThemeResource SystemControlForegroundChromeDisabledLowBrush}"
                        Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
                    <Grid RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="8,8,8,0">
                            <TextBlock Text="Дерево файлів" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Padding="4" Background="Transparent" BorderThickness="0"
                                    ToolTipService.ToolTip="Відкрити в окремому вікні"
                                    Command="{x:Bind ViewModel.OpenTreeViewWindowCommand}">
                                <FontIcon Glyph="&#xE8A7;" FontSize="14"/>
                            </Button>
                        </Grid>
                        
                        <uc:TreeViewControl Grid.Row="1" ViewModel="{x:Bind ViewModel}" />
                    </Grid>
                </Border>

                <sizers:GridSplitter Grid.Column="1" Width="8" Cursor="SizeWestEast" Background="Transparent"
                                     ResizeBehavior="BasedOnAlignment" />

                <Border Grid.Column="2" Margin="8" CornerRadius="4"
                        BorderThickness="1" BorderBrush="{ThemeResource SystemControlForegroundChromeDisabledLowBrush}"
                        Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
                    <Grid>
                        <TextBlock Text="NO DATA" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                   Visibility="{x:Bind GetNoDataVisibility(ViewModel.TypeStatistics.Count, ViewModel.IsScanning), Mode=OneWay}" />

                        <Grid RowDefinitions="Auto,*">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="8,8,8,0">
                                <TextBlock Text="Статистика" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                
                                <Button Grid.Column="1" Padding="4" Background="Transparent" BorderThickness="0" 
                                        ToolTipService.ToolTip="Відкрити в окремому вікні"
                                        Command="{x:Bind ViewModel.OpenStatisticsWindowCommand}">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="14"/>
                                </Button>
                            </Grid>

                            <uc:StatisticsControl Grid.Row="1" ViewModel="{x:Bind ViewModel}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <sizers:GridSplitter Grid.Row="1" Height="8" Cursor="SizeNorthSouth" Background="Transparent"
                                 ResizeBehavior="BasedOnAlignment" />

            <Border Grid.Row="2" Margin="8" CornerRadius="4" BorderThickness="1"
                    BorderBrush="{ThemeResource SystemControlForegroundChromeDisabledLowBrush}"
                    Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="8,8,8,0">
                        <TextBlock Text="TreeMap" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Padding="4" Background="Transparent" BorderThickness="0"
                                ToolTipService.ToolTip="Відкрити в окремому вікні"
                                Command="{x:Bind ViewModel.OpenTreeMapWindowCommand}">
                            <FontIcon Glyph="&#xE8A7;" FontSize="14"/>
                        </Button>
                    </Grid>
                    
                    <uc:TreeMapControl Grid.Row="1" ViewModel="{x:Bind ViewModel}" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="0" Grid.RowSpan="3" 
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="16"
                        Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            
                <ProgressRing IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" 
                              Width="64" Height="64" 
                              HorizontalAlignment="Center"/>
            
                <Button Content="Скасувати сканування" 
                        Command="{x:Bind ViewModel.CancelScanCommand}"
                        HorizontalAlignment="Center" />
            
            </StackPanel>
            
        </Grid>
    </Grid>
</Page>