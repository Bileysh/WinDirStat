<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="WinDirStat_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sizers="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:WinDirStat.ViewModels"
    xmlns:converters="using:WinDirStat_App.Converters"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:FileCategoryToBrushConverter x:Key="CategoryToBrushConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <MenuBar Grid.Row="0">
            <MenuBarItem Title="File">
                <MenuFlyoutItem Text="Open Folder..." Icon="Folder" Command="{x:Bind ViewModel.OpenFolderCommand}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Exit" Icon="Cancel" />
            </MenuBarItem>
            <MenuBarItem Title="Options">
                <MenuFlyoutItem Text="Show Free Space" />
            </MenuBarItem>
            <MenuBarItem Title="Help">
                <MenuFlyoutItem Text="About WinDirStat" Icon="Help" />
            </MenuBarItem>
        </MenuBar>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="6*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="4*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="4*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="8" CornerRadius="4" 
                        BorderThickness="1" BorderBrush="{ThemeResource SystemControlForegroundChromeDisabledLowBrush}"
                        Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
                    <Grid>
                        <TextBlock Text="NO DATA" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                   Visibility="{x:Bind GetNoDataVisibility(ViewModel.RootNodes.Count, ViewModel.IsScanning), Mode=OneWay}"/>
                        
                        <TreeView x:Name="FileTreeView"
                                  ItemsSource="{x:Bind ViewModel.RootNodes, Mode=OneWay}">
                            <TreeView.ItemTemplate>
                                <DataTemplate x:DataType="vm:NodeViewModel">
                                    <TreeViewItem ItemsSource="{x:Bind Children}">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="{x:Bind Name}" Width="220"/>
                                            <TextBlock Text="{x:Bind SizeLogicalFormatted}" Width="80" Opacity="0.7"/>
                                            <TextBlock Text="{x:Bind SizePhysicalFormatted}" Width="80" Opacity="0.7"/>
                                            <TextBlock Text="{x:Bind LastModified}" Width="140" Opacity="0.5"/>
                                            <TextBlock Text="{x:Bind PercentOfParentFormatted}" Width="50"/>
                                            <TextBlock Text="{x:Bind ChildSummaryFormatted}" Width="140" Opacity="0.6"/>
                                        </StackPanel>
                                    </TreeViewItem>
                                </DataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Grid>
                </Border>

                <sizers:GridSplitter Grid.Column="1" Width="8" Cursor="SizeWestEast" Background="Transparent"
                                     ResizeBehavior="BasedOnAlignment" />
                
                <Border Grid.Column="2" Margin="8" CornerRadius="4" 
                        BorderThickness="1" BorderBrush="{ThemeResource SystemControlForegroundChromeDisabledLowBrush}"
                        Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
                    <Grid>
                        <TextBlock Text="NO DATA" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                   Visibility="{x:Bind GetNoDataVisibility(ViewModel.TypeStatistics.Count, ViewModel.IsScanning), Mode=OneWay}"/>
                        
                        <Grid RowDefinitions="Auto,*">
                            <ToggleSwitch Grid.Row="0" Margin="8"
                                          OnContent="За типом" OffContent="За extension"
                                          IsOn="{x:Bind ViewModel.GroupByCategory, Mode=TwoWay}" />

                            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.TypeStatistics, Mode=OneWay}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FileTypeStatisticsViewModel">
                                        <Grid ColumnDefinitions="*,Auto,Auto" Padding="8,4">
                                            <TextBlock Grid.Column="0" Text="{x:Bind Label}"/>
                                            <TextBlock Grid.Column="1" Margin="8,0" Opacity="0.7" Text="{x:Bind TotalSizeFormatted}"/>
                                            <TextBlock Grid.Column="2" Text="{x:Bind PercentFormatted}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <sizers:GridSplitter Grid.Row="1" Height="8" Cursor="SizeNorthSouth" Background="Transparent"
                                 ResizeBehavior="BasedOnAlignment" />

            <Border x:Name="TreeMapContainer" Grid.Row="2" Margin="8" CornerRadius="4" 
                    BorderThickness="1" BorderBrush="{ThemeResource SystemControlForegroundChromeDisabledLowBrush}"
                    Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                    SizeChanged="TreeMapContainer_SizeChanged">
                <Grid>
                    <TextBlock Text="NO DATA" HorizontalAlignment="Center" VerticalAlignment="Center" 
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                               Visibility="{x:Bind GetNoDataVisibility(ViewModel.TreeMapRects.Count, ViewModel.IsScanning), Mode=OneWay}"/>
                               
                    <ItemsControl ItemsSource="{x:Bind ViewModel.TreeMapRects, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TreeMapRectViewModel">
                                <Border Canvas.Left="{x:Bind X}" Canvas.Top="{x:Bind Y}"
                                        Width="{x:Bind Width}" Height="{x:Bind Height}"
                                        Background="{x:Bind Category, Converter={StaticResource CategoryToBrushConverter}}"
                                        BorderThickness="0.5" BorderBrush="Black">
                                    <TextBlock Text="{x:Bind Name}" FontSize="10" Foreground="White"
                                               Margin="2" TextTrimming="CharacterEllipsis" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
            
            <ProgressRing Grid.RowSpan="3" 
                          IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" 
                          Width="64" Height="64" 
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                          
        </Grid>
    </Grid>
</Page>