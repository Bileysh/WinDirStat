<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="WinDirStat_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sizers="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:WinDirStat.ViewModels"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <MenuBar Grid.Row="0">
            <MenuBarItem Title="File">
                <MenuFlyoutItem Text="Open Folder..." Icon="Folder" Command="{x:Bind ViewModel.OpenFolderCommand}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Exit" Icon="Cancel" />
            </MenuBarItem>
            <MenuBarItem Title="Options">
                <MenuFlyoutItem Text="Show Free Space" />
            </MenuBarItem>
            <MenuBarItem Title="Help">
                <MenuFlyoutItem Text="About WinDirStat" Icon="Help" />
            </MenuBarItem>
        </MenuBar>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="6*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="4*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="4*" />
                </Grid.ColumnDefinitions>
                
                <Border Grid.Column="0" Margin="8" CornerRadius="4">
                    <TreeView x:Name="FileTreeView"
                              ItemsSource="{x:Bind ViewModel.RootNodes, Mode=OneWay}">
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="vm:NodeViewModel">
                                <TreeViewItem ItemsSource="{x:Bind Children}">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="{x:Bind Name}" Width="220"/>
                                        <TextBlock Text="{x:Bind SizeLogicalFormatted}" Width="80" Opacity="0.7"/>
                                        <TextBlock Text="{x:Bind SizePhysicalFormatted}" Width="80" Opacity="0.7"/>
                                        <TextBlock Text="{x:Bind LastModified}" Width="140" Opacity="0.5"/>
                                        <TextBlock Text="{x:Bind PercentOfParentFormatted}" Width="50"/>
                                    </StackPanel>
                                </TreeViewItem>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Border>

                <sizers:GridSplitter Grid.Column="1" Width="8" Cursor="SizeWestEast" Background="Transparent"
                                     ResizeBehavior="BasedOnAlignment" />

                <Border Grid.Column="2" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                        Margin="8" CornerRadius="4">
                    <TextBlock Text="Statistics (Типи файлів)" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                </Border>
            </Grid>

            <sizers:GridSplitter Grid.Row="1" Height="8" Cursor="SizeNorthSouth" Background="Transparent"
                                 ResizeBehavior="BasedOnAlignment" />

            <Border Grid.Row="2" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" Margin="8"
                    CornerRadius="4">
                <TextBlock Text="TreeMap (Теплова карта)" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
            </Border>
        </Grid>
    </Grid>
</Page>