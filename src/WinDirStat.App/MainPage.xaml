<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="WinDirStat_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sizers="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:WinDirStat_App.Converters"
    xmlns:uc="using:WinDirStat_App.UserControls"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:FileCategoryToBrushConverter x:Key="CategoryToBrushConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <MenuBar Grid.Row="0">
            <MenuBarItem x:Uid="MenuFile">
                <MenuFlyoutItem x:Uid="MenuFileOpenFolder" Icon="Folder" Command="{x:Bind ViewModel.OpenFolderCommand}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Uid="MenuFileExit" Icon="Cancel" Command="{x:Bind ViewModel.ExitCommand}" />
            </MenuBarItem>
            <MenuBarItem x:Uid="MenuWindow">
                <MenuFlyoutItem x:Uid="MenuWindowOpenNew" Icon="NewWindow"
                                Command="{x:Bind ViewModel.OpenInNewWindowCommand}" />
            </MenuBarItem>
            <MenuBarItem x:Uid="MenuOptions">
                <MenuFlyoutSubItem x:Uid="MenuOptionsLanguage" Icon="Globe">
                    <MenuFlyoutItem Text="Українська"
                                    Command="{x:Bind ViewModel.ChangeLanguageCommand}"
                                    CommandParameter="uk-UA" />
                    <MenuFlyoutItem Text="English"
                                    Command="{x:Bind ViewModel.ChangeLanguageCommand}"
                                    CommandParameter="en-US" />
                </MenuFlyoutSubItem>
                <MenuFlyoutItem x:Uid="MenuOptionsTheme" Icon="Highlight"
                                Command="{x:Bind ViewModel.ToggleThemeCommand}" />
            </MenuBarItem>

            <MenuBarItem x:Uid="MenuHelp">
                <MenuFlyoutItem x:Uid="MenuHelpAbout" Icon="Help" Command="{x:Bind ViewModel.ShowAboutCommand}" />
            </MenuBarItem>
        </MenuBar>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="6*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="4*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="8,8,8,0"
                        Visibility="{x:Bind ViewModel.TreeMapAbsoluteRootPath, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}">
                <FontIcon Glyph="&#xE8B7;" FontSize="14"
                          Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                <TextBlock Text="{x:Bind ViewModel.TreeMapAbsoluteRootPath, Mode=OneWay}"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           ToolTipService.ToolTip="{x:Bind ViewModel.TreeMapAbsoluteRootPath, Mode=OneWay}" />
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="4*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="8" CornerRadius="4" BorderThickness="1"
                        BorderBrush="{ThemeResource SystemControlForegroundChromeDisabledLowBrush}"
                        Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
                    <Grid RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="8,8,8,0">
                            <TextBlock x:Uid="TreeViewHeader" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Padding="4" Background="Transparent" BorderThickness="0"
                                    x:Uid="OpenTreeViewWindowButton"
                                    Command="{x:Bind ViewModel.OpenTreeViewWindowCommand}">
                                <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                            </Button>
                        </Grid>

                        <uc:TreeViewControl Grid.Row="1" ViewModel="{x:Bind ViewModel}" />
                    </Grid>
                </Border>

                <sizers:GridSplitter Grid.Column="1" Width="8" Cursor="SizeWestEast" Background="Transparent"
                                     ResizeBehavior="BasedOnAlignment" />

                <Border Grid.Column="2" Margin="8" CornerRadius="4"
                        BorderThickness="1" BorderBrush="{ThemeResource SystemControlForegroundChromeDisabledLowBrush}"
                        Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
                    <Grid>
                        <Grid RowDefinitions="Auto,*">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="8,8,8,0">
                                <TextBlock x:Uid="StatisticsHeader" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Padding="4" Background="Transparent" BorderThickness="0"
                                        x:Uid="OpenStatisticsWindowButton"
                                        Command="{x:Bind ViewModel.OpenStatisticsWindowCommand}">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                                </Button>
                            </Grid>

                            <uc:StatisticsControl Grid.Row="1" ViewModel="{x:Bind ViewModel}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <sizers:GridSplitter Grid.Row="2" Height="8" Cursor="SizeNorthSouth" Background="Transparent"
                                 ResizeBehavior="BasedOnAlignment" />

            <Border Grid.Row="3" Margin="8" CornerRadius="4" BorderThickness="1"
                    BorderBrush="{ThemeResource SystemControlForegroundChromeDisabledLowBrush}"
                    Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="8,8,8,0">
                        <TextBlock x:Uid="TreeMapHeader" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Padding="4" Background="Transparent" BorderThickness="0"
                                x:Uid="OpenTreeMapWindowButton" Command="{x:Bind ViewModel.OpenTreeMapWindowCommand}">
                            <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                        </Button>
                    </Grid>

                    <uc:TreeMapControl Grid.Row="1" ViewModel="{x:Bind ViewModel}" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="0" Grid.RowSpan="4"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="16"
                        Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">

                <ProgressRing IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                              Width="64" Height="64"
                              HorizontalAlignment="Center" />

                <Button x:Uid="CancelScanButton" Command="{x:Bind ViewModel.CancelScanCommand}"
                        HorizontalAlignment="Center" />

            </StackPanel>

            <uc:DriveSelectorControl Grid.Row="0" Grid.RowSpan="4"
                                     ViewModel="{x:Bind ViewModel}"
                                     Visibility="{x:Bind ViewModel.ShowDriveSelector, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

        </Grid>
    </Grid>
</Page>