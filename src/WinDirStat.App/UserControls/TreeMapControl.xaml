<UserControl
    x:Class="WinDirStat_App.UserControls.TreeMapControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinDirStat.ViewModels"
    xmlns:converters="using:WinDirStat_App.Converters">

    <UserControl.Resources>
        <converters:FileCategoryToBrushConverter x:Key="CategoryToBrushConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,0,4,8"
              Visibility="{x:Bind ViewModel.IsTreeMapNavigated, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" MaxWidth="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Command="{x:Bind ViewModel.NavigateUpTreeMapCommand}"
                    Padding="4" Background="Transparent" BorderThickness="0"
                    x:Uid="NavigateUpButton" Margin="0,0,4,0">
                <FontIcon Glyph="&#xE72B;" FontSize="12" />
            </Button>

            <TextBlock Grid.Column="1"
                       Text="{x:Bind ViewModel.TreeMapAbsoluteRootPath, Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                       FontSize="12" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       ToolTipService.ToolTip="{x:Bind ViewModel.TreeMapAbsoluteRootPath, Mode=OneWay}" />

            <TextBlock Grid.Column="2"
                       Text="{x:Bind ViewModel.TreeMapRelativePath, Mode=OneWay}"
                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                       FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       ToolTipService.ToolTip="{x:Bind ViewModel.TreeMapRelativePath, Mode=OneWay}" />
        </Grid>

        <Grid x:Name="MapContainer" Grid.Row="1" SizeChanged="MapContainer_SizeChanged">
            <TextBlock Grid.Row="1" x:Uid="NoDataText" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                       Visibility="{x:Bind GetNoDataVisibility(ViewModel.TreeMapRects.Count, ViewModel.IsScanning), Mode=OneWay}" />

            <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.TreeMapRects, Mode=OneWay}"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TreeMapRectViewModel">
                        <Border Width="{x:Bind Width}" Height="{x:Bind Height}"
                                Background="{x:Bind Category, Converter={StaticResource CategoryToBrushConverter}}"
                                BorderThickness="1" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                ToolTipService.ToolTip="{x:Bind ToolTipText}"
                                Tapped="OnRectTapped">
                            
                            <Border.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:Uid="MenuShowInExplorer"
                                                    Command="{x:Bind OpenInExplorerCommand}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xEC50;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Border.ContextFlyout>

                            <Border.RenderTransform>
                                <TranslateTransform X="{x:Bind X}" Y="{x:Bind Y}" />
                            </Border.RenderTransform>
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="4"
                                            HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Visibility="{x:Bind IsTitleVisible, Converter={StaticResource BoolToVisibilityConverter}}">

                                    <FontIcon Glyph="&#xE8B7;" FontSize="11" Foreground="White"
                                              Visibility="{x:Bind IsFolder, Converter={StaticResource BoolToVisibilityConverter}}" />

                                    <TextBlock Text="{x:Bind Name}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="White"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <TextBlock Text="{x:Bind SizeFormatted}" FontSize="9" Foreground="White" Opacity="0.8"
                                           HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4"
                                           Visibility="{x:Bind IsSizeVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</UserControl>