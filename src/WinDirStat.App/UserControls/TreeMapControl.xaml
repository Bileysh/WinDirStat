<UserControl
    x:Class="WinDirStat_App.UserControls.TreeMapControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinDirStat.ViewModels"
    xmlns:converters="using:WinDirStat_App.Converters">

    <UserControl.Resources>
        <converters:FileCategoryToBrushConverter x:Key="CategoryToBrushConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="4,0,4,8"
                    Visibility="{x:Bind ViewModel.IsTreeMapNavigated, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Button Command="{x:Bind ViewModel.NavigateUpTreeMapCommand}"
                    Padding="4" Background="Transparent" BorderThickness="0"
                    ToolTipService.ToolTip="Повернутися на рівень вище">
                <FontIcon Glyph="&#xE72B;" FontSize="12" />
            </Button>
            <TextBlock Text="{x:Bind ViewModel.CurrentTreeMapRoot.Name, Mode=OneWay}"
                       VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Opacity="0.8" />
        </StackPanel>

        <Grid x:Name="MapContainer" Grid.Row="1" SizeChanged="MapContainer_SizeChanged">
            <TextBlock Text="NO DATA" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                       Visibility="{x:Bind GetNoDataVisibility(ViewModel.TreeMapRects.Count, ViewModel.IsScanning), Mode=OneWay}" />
            
        <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.TreeMapRects, Mode=OneWay}"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TreeMapRectViewModel">
                    <Border Width="{x:Bind Width}" Height="{x:Bind Height}"
                            Background="{x:Bind Category, Converter={StaticResource CategoryToBrushConverter}}"
                            BorderThickness="1" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                            ToolTipService.ToolTip="{x:Bind ToolTipText}"
                            Tapped="OnRectTapped">
                        <Border.RenderTransform>
                            <TranslateTransform X="{x:Bind X}" Y="{x:Bind Y}" />
                        </Border.RenderTransform>
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="4"
                                        HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Visibility="{x:Bind IsTitleVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                
                                <FontIcon Glyph="&#xE8B7;" FontSize="11" Foreground="White"
                                          Visibility="{x:Bind IsFolder, Converter={StaticResource BoolToVisibilityConverter}}" />
                                
                                <TextBlock Text="{x:Bind Name}" FontSize="11" FontWeight="SemiBold" Foreground="White"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            
                            <TextBlock Text="{x:Bind SizeFormatted}" FontSize="9" Foreground="White" Opacity="0.8"
                                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4"
                                       Visibility="{x:Bind IsSizeVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid></Grid>
</UserControl>