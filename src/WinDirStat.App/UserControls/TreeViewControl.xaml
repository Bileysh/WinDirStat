<UserControl
    x:Class="WinDirStat_App.UserControls.TreeViewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinDirStat.ViewModels"
    xmlns:converters="using:WinDirStat_App.Converters">

    <UserControl.Resources>
        <converters:NodeSummaryConverter x:Key="NodeSummaryConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Padding="12,4"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}">
            <TextBlock x:Uid="TreeColumnName" Width="220" Opacity="0.7" FontSize="12" />
            <TextBlock Width="16" />
            <TextBlock x:Uid="TreeColumnSizeLogical" Width="80" Opacity="0.7" FontSize="12" />
            <TextBlock x:Uid="TreeColumnSizePhysical" Width="80" Opacity="0.7" FontSize="12" />
            <TextBlock x:Uid="TreeColumnLastModified" Width="140" Opacity="0.7" FontSize="12" />
            <TextBlock x:Uid="TreeColumnPercent" Width="50" Opacity="0.7" FontSize="12" />
        </StackPanel>

        <Grid Grid.Row="1">
            <TextBlock x:Uid="NoDataText" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                       Visibility="{x:Bind GetNoDataVisibility(ViewModel.RootNodes.Count, ViewModel.IsScanning), Mode=OneWay}" />

            <TreeView ItemsSource="{x:Bind ViewModel.RootNodes, Mode=OneWay}">
                <TreeView.ItemTemplate>
                    <DataTemplate x:DataType="vm:NodeViewModel">
                        <TreeViewItem ItemsSource="{x:Bind Children}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="{x:Bind Name}" Width="220" />
                                <TextBlock Text="{x:Bind StatusGlyph}" FontFamily="Segoe MDL2 Assets"
                                           Width="16" Opacity="0.7"
                                           Visibility="{x:Bind HasStatusIcon, Mode=OneWay}"
                                           ToolTipService.ToolTip="{x:Bind StatusTooltip, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind SizeLogicalFormatted}" Width="80" Opacity="0.7" />
                                <TextBlock Text="{x:Bind SizePhysicalFormatted}" Width="80" Opacity="0.7" />
                                <TextBlock Text="{x:Bind LastModified}" Width="140" Opacity="0.5" />
                                <TextBlock Text="{x:Bind PercentOfParentFormatted}" Width="50" />
                                <TextBlock Text="{x:Bind Converter={StaticResource NodeSummaryConverter}}" />
                            </StackPanel>
                        </TreeViewItem>
                    </DataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>
    </Grid>
</UserControl>