<UserControl
    x:Class="WinDirStat_App.UserControls.StatisticsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinDirStat.ViewModels"
    xmlns:converters="using:WinDirStat_App.Converters">

    <UserControl.Resources>
        <converters:FileCategoryToBrushConverter x:Key="CategoryToBrushConverter" />
        <converters:StatisticsLabelConverter x:Key="StatisticsLabelConverter" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*">
        <ToggleSwitch Grid.Row="0" Margin="8"
                      x:Uid="ToggleGroupBy"
                      IsOn="{x:Bind ViewModel.GroupByCategory, Mode=TwoWay}" />

        <TextBlock Grid.Row="1" x:Uid="NoDataText" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                   Visibility="{x:Bind GetNoDataVisibility(ViewModel.TypeStatistics.Count, ViewModel.IsScanning), Mode=OneWay}" />

        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.TypeStatistics, Mode=OneWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:FileTypeStatisticsViewModel">
                    <Grid ColumnDefinitions="*,Auto,Auto" Padding="8,4">

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <Border Width="12" Height="12" CornerRadius="2"
                                    Background="{x:Bind Category, Converter={StaticResource CategoryToBrushConverter}}" />

                            <FontIcon Glyph="{x:Bind IconGlyph}"
                                      FontSize="14"
                                      VerticalAlignment="Center"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      Opacity="0.8" />

                            <TextBlock Text="{x:Bind Mode=OneWay, Converter={StaticResource StatisticsLabelConverter}}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock Grid.Column="1" Margin="8,0" Opacity="0.7"
                                   Text="{x:Bind TotalSizeFormatted}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{x:Bind PercentFormatted}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>