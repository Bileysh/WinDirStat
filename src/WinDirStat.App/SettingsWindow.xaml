<Window
    x:Class="WinDirStat_App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="20" MaxWidth="440">
            <NumberBox x:Name="ScanIntervalNumberBox" x:Uid="SettingsScanIntervalNumberBox"
                       Minimum="15" SmallChange="15" LargeChange="60"
                       SpinButtonPlacementMode="Inline"
                       ValueChanged="ScanIntervalNumberBox_ValueChanged" />

            <StackPanel Spacing="4">
                <TextBlock x:Uid="SettingsThresholdSliderLabel" />
                <Slider Value="{x:Bind ViewModel.LowFreeSpaceThresholdPercent, Mode=TwoWay}"
                        Minimum="1" Maximum="50" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Uid="SettingsExportButton" Command="{x:Bind ViewModel.ExportCommand}" />
                <Button x:Uid="SettingsImportButton" Command="{x:Bind ViewModel.ImportCommand}" />
            </StackPanel>

            <Button x:Uid="SettingsTestScanButton" Command="{x:Bind ViewModel.TestScanNowCommand}"
                    HorizontalAlignment="Left" />

            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       Opacity="0.7" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Window>