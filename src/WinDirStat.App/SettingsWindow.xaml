<Window
    x:Class="WinDirStat_App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="Transparent">
        <ScrollViewer Padding="32">
            <StackPanel Spacing="24" MaxWidth="800" HorizontalAlignment="Stretch">
                
                <TextBlock x:Uid="SettingsHeader" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,8" />

                <StackPanel Spacing="12">
                    <TextBlock x:Uid="BgScanSettingsTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <Grid Padding="16" ColumnDefinitions="*, Auto">
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Uid="ScanIntervalInputHeader" Style="{ThemeResource BodyTextBlockStyle}" />
                                    <TextBlock x:Uid="ScanIntervalInputDesc" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <NumberBox Grid.Column="1" Value="{x:Bind ViewModel.ScanIntervalMinutes, Mode=TwoWay}" Minimum="15" Maximum="1440" SpinButtonPlacementMode="Compact" Width="140" VerticalAlignment="Center" />
                            </Grid>
                            
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            
                            <Grid Padding="16" ColumnDefinitions="*, Auto">
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Uid="SpaceThresholdInputHeader" Style="{ThemeResource BodyTextBlockStyle}" />
                                    <TextBlock x:Uid="SpaceThresholdInputDesc" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <NumberBox Grid.Column="1" Value="{x:Bind ViewModel.LowFreeSpaceThresholdPercent, Mode=TwoWay}" Minimum="1" Maximum="50" SpinButtonPlacementMode="Compact" Width="140" VerticalAlignment="Center" />
                            </Grid>
                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <Grid Padding="16" ColumnDefinitions="*, Auto">
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Uid="AccountForHardLinksHeader" Style="{ThemeResource BodyTextBlockStyle}" />
                                    <TextBlock x:Uid="AccountForHardLinksDesc" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.AccountForHardLinks, Mode=TwoWay}"
                                              OnContent="" OffContent="" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock x:Uid="DataSettingsTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <Grid Padding="16" ColumnDefinitions="*, Auto">
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Uid="ExportImportHeader" Style="{ThemeResource BodyTextBlockStyle}" />
                                    <TextBlock x:Uid="ExportImportDesc" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="{ThemeResource SystemControlErrorTextForegroundBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button x:Uid="ExportSettingsBtn" Command="{x:Bind ViewModel.ExportCommand}" />
                                    <Button x:Uid="ImportSettingsBtn" Command="{x:Bind ViewModel.ImportCommand}" />
                                </StackPanel>
                            </Grid>

                            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            
                            <Grid Padding="16" ColumnDefinitions="*, Auto">
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Uid="TestNotificationHeader" Style="{ThemeResource BodyTextBlockStyle}" />
                                    <TextBlock x:Uid="TestNotificationDesc" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Button Grid.Column="1" x:Uid="TestNotificationBtn" Command="{x:Bind ViewModel.TestScanNowCommand}" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
