<UserControl
    x:Class="Volumetric_App.UserControls.DriveSelectorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Volumetric.ViewModels"
    xmlns:converters="using:Volumetric_App.Converters">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="480">

            <TextBlock x:Uid="SelectDriveHeader" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.AvailableDrives, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DriveItemViewModel">
                        <Border Padding="12" CornerRadius="4" BorderThickness="1"
                                BorderBrush="{ThemeResource SystemControlForegroundChromeDisabledLowBrush}"
                                Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                                Tapped="OnDriveTapped">
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto">
                                <FontIcon Grid.Row="0" Grid.Column="0" Glyph="&#xEDA2;" FontSize="16"
                                          Margin="0,0,8,0" VerticalAlignment="Center" />

                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind DisplayName}"
                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />

                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{x:Bind CapacitySummary}"
                                           Opacity="0.7" FontSize="12" VerticalAlignment="Center" />

                                <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                             IsTabStop="False"
                                             AutomationProperties.AccessibilityView="Raw"
                                             Margin="0,8,0,0"
                                             Minimum="0" Maximum="100" Value="{x:Bind UsedPercent}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                <Button x:Uid="SelectCustomFolderButton" Command="{x:Bind ViewModel.OpenFolderCommand}" />
                <Button x:Uid="RefreshDrivesButton" Command="{x:Bind ViewModel.RefreshDrivesCommand}">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </StackPanel>

            <StackPanel Spacing="8"
                        Visibility="{x:Bind ViewModel.HasRecentScans, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock x:Uid="RecentScansHeader" FontSize="13" FontWeight="SemiBold" Opacity="0.7" />

                <ItemsControl ItemsSource="{x:Bind ViewModel.RecentScans, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RecentScanItemViewModel">
                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Background="Transparent" BorderThickness="0" Padding="8,6"
                                    Click="OnRecentScanClick"
                                    ToolTipService.ToolTip="{x:Bind FullPath}"
                                    AutomationProperties.Name="{x:Bind FullPath}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE81C;" FontSize="14" Opacity="0.7"
                                              AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

        </StackPanel>
    </Grid>
</UserControl>
