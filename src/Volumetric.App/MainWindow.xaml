<?xml version="1.0" encoding="utf-8"?>

<Window
    x:Class="Volumetric_App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tb="using:H.NotifyIcon"
    Title="Volumetric"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="AppTitleBar" Grid.Column="0" Background="Transparent" Padding="12,0">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Image Source="/Assets/AppIcon.ico" Width="18" Height="18" />
                    <TextBlock Text="Volumetric" VerticalAlignment="Center" FontSize="12" />
                </StackPanel>
            </Grid>

            <AutoSuggestBox x:Name="SearchBox" Grid.Column="1" VerticalAlignment="Center"
                             Margin="0,8,12,8" QueryIcon="Find" x:Uid="TitleBarSearchBox"
                             Text="{x:Bind ViewModel.SearchText, Mode=OneWay}"
                             TextChanged="SearchBox_OnTextChanged"
                             Visibility="{x:Bind LockViewModel.IsUnlocked, Mode=OneWay}" />
        </Grid>

        <Frame x:Name="RootFrame" Grid.Row="1"
               Visibility="{x:Bind LockViewModel.IsUnlocked, Mode=OneWay}" />

        <StackPanel x:Name="LockOverlay" Grid.Row="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="12" MaxWidth="420"
                    Visibility="{x:Bind LockViewModel.IsLocked, Mode=OneWay}">
            <FontIcon Glyph="&#xE72E;" FontSize="48" HorizontalAlignment="Center" />
            <TextBlock x:Uid="AppLockedTitle" Style="{ThemeResource SubtitleTextBlockStyle}"
                       HorizontalAlignment="Center" TextAlignment="Center" />
            <TextBlock x:Uid="AppLockedDesc" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="{x:Bind LockViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap"
                       TextAlignment="Center" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
            <Button x:Uid="UnlockButton" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Center"
                    Command="{x:Bind LockViewModel.UnlockCommand}" />
        </StackPanel>

        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="Volumetric"
                        LeftClickCommand="{x:Bind RestoreWindowCommand}"
                        DoubleClickCommand="{x:Bind RestoreWindowCommand}">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Uid="TrayMenuScan" Command="{x:Bind ScanFromTrayCommand}"
                                    Icon="Find" />
                    <MenuFlyoutItem x:Uid="TrayMenuOpen" Command="{x:Bind RestoreWindowCommand}" Icon="NewWindow" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Uid="TrayMenuExit" Command="{x:Bind ExitCommand}" Icon="Cancel" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

    </Grid>
</Window>
